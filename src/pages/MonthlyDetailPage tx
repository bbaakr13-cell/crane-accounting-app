  async function createPdfCanvas() {
    await ensureHacenFont();

    const canvas =
      document.createElement(
        'canvas'
      );

    canvas.width =
      PDF_WIDTH *
      PDF_SCALE;

    canvas.height =
      PDF_HEIGHT *
      PDF_SCALE;

    const ctx =
      canvas.getContext(
        '2d'
      );

    if (
      !ctx
    ) {
      throw new Error(
        'تعذر إنشاء Canvas'
      );
    }

    ctx.scale(
      PDF_SCALE,
      PDF_SCALE
    );

    ctx.imageSmoothingEnabled =
      true;

    ctx.imageSmoothingQuality =
      'high';

    const NAVY =
      '#082c5f';

    const GREEN =
      '#129c70';

    const RED =
      '#d32f2f';

    const BORDER =
      '#bcd4ea';

    const TEXT =
      '#0f172a';

    ctx.fillStyle =
      '#ffffff';

    ctx.fillRect(
      0,
      0,
      PDF_WIDTH,
      PDF_HEIGHT
    );

    /*
      الهيدر
    */
    const headerH =
      304;

    try {
      const image =
        await loadCanvasImage(
          MONTHLY_HEADER_URL
        );

      ctx.drawImage(
        image,
        0,
        0,
        PDF_WIDTH,
        headerH
      );
    } catch (
      error
    ) {
      console.error(
        'HEADER:',
        error
      );

      ctx.fillStyle =
        '#eef7ff';

      ctx.fillRect(
        0,
        0,
        PDF_WIDTH,
        headerH
      );

      drawEnglish(
        ctx,
        'BAKR PRO',
        PDF_WIDTH /
          2,
        60,
        36,
        NAVY
      );
    }

    /*
      ثلاث خانات فقط:
      المعدة | الشهر | السنة
    */

    const fieldsY =
      267;

    const fieldsH =
      30;

    const gap = 10;

    const yearW =
      130;

    const monthW =
      160;

    const equipmentW =
      PDF_WIDTH -
      36 -
      yearW -
      monthW -
      gap * 2;

    /*
      السنة - يسار
    */
    roundedRect(
      ctx,
      18,
      fieldsY,
      yearW,
      fieldsH,
      8
    );

    ctx.fillStyle =
      'rgba(255,255,255,0.96)';

    ctx.fill();

    ctx.strokeStyle =
      '#bcd4ea';

    ctx.stroke();

    drawArabic(
      ctx,
      'السنة',
      18 +
        yearW / 2,
      fieldsY + 8,
      9,
      NAVY
    );

    drawEnglish(
      ctx,
      String(year),
      18 +
        yearW / 2,
      fieldsY + 21,
      18,
      TEXT,
      800
    );

    /*
      الشهر - الوسط
    */
    const monthX =
      18 +
      yearW +
      gap;

    roundedRect(
      ctx,
      monthX,
      fieldsY,
      monthW,
      fieldsH,
      8
    );

    ctx.fillStyle =
      'rgba(255,255,255,0.96)';

    ctx.fill();

    ctx.strokeStyle =
      '#bcd4ea';

    ctx.stroke();

    drawArabic(
      ctx,
      'الشهر',
      monthX +
        monthW / 2,
      fieldsY + 8,
      9,
      NAVY
    );

    drawArabic(
      ctx,
      monthNames[
        month
      ],
      monthX +
        monthW / 2,
      fieldsY + 21,
      18,
      TEXT
    );

    /*
      المعدة - يمين
    */
    const equipmentX =
      monthX +
      monthW +
      gap;

    roundedRect(
      ctx,
      equipmentX,
      fieldsY,
      equipmentW,
      fieldsH,
      8
    );

    ctx.fillStyle =
      'rgba(255,255,255,0.96)';

    ctx.fill();

    ctx.strokeStyle =
      '#bcd4ea';

    ctx.stroke();

    drawArabic(
      ctx,
      'المعدة',
      equipmentX +
        equipmentW / 2,
      fieldsY + 8,
      9,
      NAVY
    );

    const equipmentFont =
      fitFontSize(
        ctx,
        displayEquipmentName,
        equipmentW - 20,
        18,
        14,
        HACEN_FONT_NAME
      );

    drawArabic(
      ctx,
      displayEquipmentName,
      equipmentX +
        equipmentW / 2,
      fieldsY + 21,
      equipmentFont,
      TEXT
    );

    /*
      الجدول
    */

    const tableX =
      18;

    const tableY =
      310;

    const tableWidth =
      PDF_WIDTH - 36;

    const tableHeaderH =
      36;

    const summaryStartY =
      1000;

    const rowHeight =
      (
        summaryStartY -
        tableY -
        tableHeaderH -
        6
      ) / 31;

    const columns = [
      {
        key:
          'day',
        label:
          'اليوم',
        ratio:
          0.07,
      },
      {
        key:
          'work',
        label:
          'نوع العمل',
        ratio:
          0.20,
      },
      {
        key:
          'location',
        label:
          'موقع العمل',
        ratio:
          0.20,
      },
      {
        key:
          'trip',
        label:
          'سعر المشوار',
        ratio:
          0.18,
      },
      {
        key:
          'expense',
        label:
          'مصاريف أخرى',
        ratio:
          0.20,
      },
      {
        key:
          'amount',
        label:
          'المبلغ',
        ratio:
          0.15,
      },
    ];

    let cursorX =
      tableX +
      tableWidth;

    const columnRects =
      columns.map(
        (
          column
        ) => {
          const width =
            tableWidth *
            column.ratio;

          cursorX -=
            width;

          return {
            ...column,
            x:
              cursorX,
            width,
          };
        }
      );

    columnRects.forEach(
      (
        column
      ) => {
        const gradient =
          ctx.createLinearGradient(
            column.x,
            tableY,
            column.x,
            tableY +
              tableHeaderH
          );

        gradient.addColorStop(
          0,
          '#0f5fb7'
        );

        gradient.addColorStop(
          1,
          '#063a78'
        );

        ctx.fillStyle =
          gradient;

        ctx.fillRect(
          column.x,
          tableY,
          column.width,
          tableHeaderH
        );

        ctx.strokeStyle =
          '#ffffff66';

        ctx.strokeRect(
          column.x,
          tableY,
          column.width,
          tableHeaderH
        );

        const size =
          fitFontSize(
            ctx,
            column.label,
            column.width -
              10,
            19,
            14,
            HACEN_FONT_NAME
          );

        drawArabic(
          ctx,
          column.label,
          column.x +
            column.width /
              2,
          tableY +
            tableHeaderH /
              2,
          size,
          '#ffffff'
        );
      }
    );

    for (
      let day = 1;
      day <= 31;
      day += 1
    ) {
      const row =
        getPdfRow(
          day
        );

      const rowY =
        tableY +
        tableHeaderH +
        (
          day - 1
        ) *
          rowHeight;

      const linkedTotal =
        getDayExternalTotal(
          day
        );

      const categories =
        getDayExternalCategories(
          day
        );

      const combinedExpense =
        (
          Number(
            row.expenseAmount
          ) || 0
        ) +
        linkedTotal;

      const expenseText =
        [
          row.expenseType,
          categories,
        ]
          .filter(
            Boolean
          )
          .join(
            ' + '
          );

      const values:
        Record<
          string,
          string
        > = {
        day:
          String(
            day
          ),

        work:
          row.workType,

        location:
          row.tripType,

        trip:
          row.tripPrice >
          0
            ? row.tripPrice.toLocaleString(
                'en-US'
              )
            : '',

        expense:
          expenseText,

        amount:
          combinedExpense >
          0
            ? combinedExpense.toLocaleString(
                'en-US'
              )
            : '',
      };

      columnRects.forEach(
        (
          column
        ) => {
          ctx.fillStyle =
            day % 2 ===
            0
              ? '#eef7ff'
              : '#ffffff';

          ctx.fillRect(
            column.x,
            rowY,
            column.width,
            rowHeight
          );

          ctx.strokeStyle =
            BORDER;

          ctx.lineWidth =
            0.55;

          ctx.strokeRect(
            column.x,
            rowY,
            column.width,
            rowHeight
          );

          const value =
            values[
              column.key
            ] || '';

          if (
            !value
          ) {
            return;
          }

          /*
            خط القيم = 14
          */
          const size =
            fitFontSize(
              ctx,
              value,
              column.width -
                6,
              14,
              10,
              HACEN_FONT_NAME
            );

          let color =
            TEXT;

          if (
            column.key ===
              'trip' &&
            row.tripPrice >
              0
          ) {
            color =
              GREEN;
          }

          if (
            column.key ===
              'amount' &&
            combinedExpense >
              0
          ) {
            color =
              RED;
          }

          drawArabic(
            ctx,
            value,
            column.x +
              column.width /
                2,
            rowY +
              rowHeight /
                2,
            size,
            color
          );
        }
      );
    }

    /*
      الملخص الصغير
    */

    const summaryY =
      summaryStartY +
      8;

    const summaryGap =
      8;

    const summaryWidth =
      (
        PDF_WIDTH -
        36 -
        summaryGap * 3
      ) / 4;

    const summaryH =
      54;

    const items = [
      {
        label:
          'إجمالي المشاوير',
        value:
          String(
            totals.trips
          ),
        color:
          '#5b21b6',
        bg:
          '#f7f3ff',
      },
      {
        label:
          'إجمالي الدخل',
        value:
          `${totals.income.toLocaleString('en-US')} ر.س`,
        color:
          GREEN,
        bg:
          '#eefcf4',
      },
      {
        label:
          'إجمالي المصروفات',
        value:
          `${totalExpense.toLocaleString('en-US')} ر.س`,
        color:
          RED,
        bg:
          '#fff3f3',
      },
      {
        label:
          'صافي الشهر',
        value:
          `${net.toLocaleString('en-US')} ر.س`,
        color:
          net >= 0
            ? NAVY
            : RED,
        bg:
          '#fff8ee',
      },
    ];

    items.forEach(
      (
        item,
        index
      ) => {
        const x =
          PDF_WIDTH -
          18 -
          summaryWidth -
          index *
            (
              summaryWidth +
              summaryGap
            );

        roundedRect(
          ctx,
          x,
          summaryY,
          summaryWidth,
          summaryH,
          9
        );

        ctx.fillStyle =
          item.bg;

        ctx.fill();

        ctx.strokeStyle =
          `${item.color}55`;

        ctx.stroke();

        drawArabic(
          ctx,
          item.label,
          x +
            summaryWidth /
              2,
          summaryY +
            18,
          11.5,
          TEXT
        );

        drawArabic(
          ctx,
          item.value,
          x +
            summaryWidth /
              2,
          summaryY +
            39,
          14,
          item.color
        );
      }
    );

    const rightsY =
      summaryY +
      summaryH +
      21;

    drawEnglish(
      ctx,
      '0558995962',
      120,
      rightsY,
      12,
      NAVY,
      900
    );

    drawEnglish(
      ctx,
      'BAKR ALMASBHI © 2026 — All Rights Reserved.',
      PDF_WIDTH /
        2,
      rightsY,
      9,
      '#334155',
      700
    );

    return canvas;
  }

  async function createPdfBlob() {
    const canvas =
      await createPdfCanvas();

    const imageData =
      canvas.toDataURL(
        'image/png'
      );

    const pdf =
      new jsPDF({
        orientation:
          'portrait',
        unit: 'mm',
        format: 'a4',
        compress:
          false,
      });

    pdf.addImage(
      imageData,
      'PNG',
      0,
      0,
      pdf.internal.pageSize.getWidth(),
      pdf.internal.pageSize.getHeight(),
      undefined,
      'NONE'
    );

    return pdf.output(
      'blob'
    );
  }

  async function createPdfFile() {
    const blob =
      await createPdfBlob();

    const base64 =
      await blobToBase64(
        blob
      );

    const result =
      await Filesystem.writeFile(
        {
          path:
            getFileName(),
          data:
            base64,
          directory:
            Directory.Cache,
        }
      );

    return result.uri;
  }

